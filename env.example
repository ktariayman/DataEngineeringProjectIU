# =============================================================================
# Environment Variables — copy this file to .env and keep it gitignored.
#
#   cp env.example .env
#
# NEVER commit the .env file to version control.
# Rotate all secrets below before deploying to any shared environment.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
# NOTE: avoid $ in values — Docker Compose treats it as a variable prefix.
POSTGRES_PASSWORD=EdNetPg2026SecureA8f3c1d
POSTGRES_DB=recommendations

# ── JWT Authentication (Recommendation API) ──────────────────────────────────
# Used to sign and verify access tokens (HS256).
# Generate a fresh secret with:  openssl rand -hex 32
JWT_SECRET=7f3a9c2d1b4e6f8a0c5d2e7b9f1a4c3d8e6b7f2a0d5c9e3b1f4a8d2c6e0f5b9

# ── API Key (internal service authentication for /auth/token) ─────────────────
# Callers must present this key to receive a JWT.
# Generate a fresh key with:  openssl rand -hex 24
API_KEY=ednet-9f2a1c4b7d3e8f0a2c5b8d1e4f7a0c3

# ── Processing ────────────────────────────────────────────────────────────────
# How many past days the Spark processing job reads on each incremental run.
PROCESSING_WINDOW_DAYS=7
